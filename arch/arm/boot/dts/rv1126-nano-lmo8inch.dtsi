			05 78 01 11
			05 14 01 29
		];

		panel-exit-sequence = [
			15 00 02 28 00
			15 00 02 10 00
		];

		display-timings {
			native-mode = <&timing0>;

			timing0: timing0 {
				clock-frequency = <68220000>;
				hactive = <800>;
				vactive = <1280>;
				hfront-porch = <20>;
				hsync-len = <20>;
				hback-porch = <20>;
				vfront-porch = <30>;
				vsync-len = <4>;
				vback-porch = <8>;
				hsync-active = <0>;
				vsync-active = <0>;
				de-active = <0>;
				pixelclk-active = <0>;
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				panel_in_dsi: endpoint {
					remote-endpoint = <&dsi_out_panel>;
				};
			};
		};
	}; //panel
}; //dsi

&i2c5 {
	status = "okay";
	pinctrl-0 = <&i2c5m1_xfer>;
	/delete-node/ gt1x@14;

	gt911@14 {
		pinctrl-names = "default";
		pinctrl-0 = <&tp_rst &tp_int>;
		compatible = "goodix,gt911";
		reg = <0x14>;
		interrupt-parent = <&gpio3>;
		interrupts = <RK_PC1 0>;

		irq-gpios = <&gpio3 RK_PC1 0>;
		reset-gpios = <&gpio3 RK_PC3 0>;
	};
};

&pinctrl {
	mipi-dsi {
		/omit-if-no-ref/
		rst_lcd: rst-lcd {
			rockchip,pins =
				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
	touch-screen {
		/omit-if-no-ref/
		tp_rst: tp_rst {
			rockchip,pins =
				<3 RK_PC3 RK_FUNC_GPIO &pcfg_pull_up>;
		};
		/omit-if-no-ref/
		tp_int: tp_int {
			rockchip,pins =
				<3 RK_PC1 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

/* use for bl in evb v10 but not nano. */
&pwm3 {
	status = "disabled";
};

&pwm8 {
	status = "okay";
	pinctrl-0 = <&pwm8m1_pins>;
};

&route_dsi {
	status = "okay";
};
