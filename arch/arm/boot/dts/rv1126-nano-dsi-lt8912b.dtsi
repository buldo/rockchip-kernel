#include <dt-bindings/display/drm_mipi_dsi.h>

/ {
	hdmi-connector {
		compatible = "hdmi-connector";
		ddc-i2c-bus = <&i2c5>;
		label = "hdmi";
		type = "a";

		port {
			hdmi_connector_in: endpoint {
				remote-endpoint = <&lt8912_out>;
			};
		};
	};
};

&display_subsystem {
	status = "okay";
};

&dsi {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port {
			reg = <0>;
			dsi_in_vop: endpoint {
				remote-endpoint = <&vop_out_dsi>;
			};
		};

		port@1 {
			reg = <1>;

			mipi_dsi_out: endpoint {
				data-lanes = <1 2 3 4>;
				remote-endpoint = <&hdmi_out_in>;
			};
		};
	};
};

&i2c5 {
	status = "okay";
	pinctrl-0 = <&i2c5m1_xfer>;

	hdmi-bridge@48 {
		pinctrl-names = "default";
		pinctrl-0 = <&panel_rst>;
		compatible = "lontium,lt8912b";
		reg = <0x48> ;
		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				hdmi_out_in: endpoint {
					data-lanes = <1 2 3 4>;
					remote-endpoint = <&mipi_dsi_out>;
				};
			};

			port@1 {
				reg = <1>;
				lt8912_out: endpoint {
					remote-endpoint = <&hdmi_connector_in>;
				};
			};
		};
	};
};

&mipi_dphy {
	status = "okay";
};

&pinctrl {
	mipi-dsi {
		/omit-if-no-ref/
		panel_rst: panel_rst {
			rockchip,pins =
				<3 RK_PC2 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&pwm8 {
	status = "okay";
	pinctrl-0 = <&pwm8m1_pins>;
};

&route_dsi {
	status = "disabled";
};

&vop {
	status = "okay";
};

&vop_mmu {
	status = "okay";
};
