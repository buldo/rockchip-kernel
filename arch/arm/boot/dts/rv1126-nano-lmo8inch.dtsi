/ {
	/delete-node/ vcc18-lcd-n;
};

&backlight {
	pwms = <&pwm8 0 25000 0>;
	default-brightness-level = <255>;
};

&display_subsystem {
	status = "okay";
};

&dsi {
	status = "okay";

	/delete-property/ rockchip,lane-rate;
	/delete-node/ panel@0;
	panel@0 {
		pinctrl-names = "default";
		pinctrl-0 = <&rst_lcd>;
		compatible = "ilitek,ili9881d", "simple-panel-dsi";
		reg = <0>;
		backlight = <&backlight>;
		reset-gpios = <&gpio3 RK_PC2 GPIO_ACTIVE_LOW>;
		prepare-delay-ms = <5>;
		reset-delay-ms = <1>;
		init-delay-ms = <80>;

		width-mm = <107>;
		height-mm = <172>;

		dsi,flags = <(MIPI_DSI_MODE_VIDEO | MIPI_DSI_MODE_VIDEO_BURST |
			      MIPI_DSI_MODE_LPM | MIPI_DSI_MODE_EOT_PACKET)>;
		dsi,format = <MIPI_DSI_FMT_RGB888>;
		dsi,lanes = <4>;

		panel-init-sequence = [
			39 00 04 FF 98 81 03
			15 00 02 01 00
			15 00 02 02 00
